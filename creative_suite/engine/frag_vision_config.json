{
  "_doc": "Frags-vision config: maps recognition classes to cinematic treatment (camera + effects + animation). Reviewed via docs/reference/frag-taxonomy-review.md. POV gameplay master (profile TR4SH_GAMEPLAY_MASTER_V2) is ALWAYS captured first; every 3D/third-person/projectile shot is an ADDITIONAL angle captured with TR4SH_CINEMATIC_REPLAY. Consumed by shot_plan.py / camera_paths.py (wiring next phase).",
  "version": 1,
  "profiles": {
    "pov": "TR4SH_GAMEPLAY_MASTER_V2",
    "cinematic": "TR4SH_CINEMATIC_REPLAY"
  },
  "camera_modes": {
    "pov": {"engine": "demo POV, no camera scripting"},
    "third_person_orbit": {"engine": "freecam + q3mme spline orbit around recorder", "radius_u": [140, 260], "height_u": [24, 96], "collision": "bsp_validate"},
    "third_person_chase": {"engine": "freecam behind recorder velocity vector", "distance_u": 180, "lag_ms": 120, "fov": 105},
    "third_person_reveal": {"engine": "static freecam at corner/LOS gap, recorder enters frame", "pre_roll_ms": 1200},
    "dodge_cam": {"engine": "side-on freecam perpendicular to enemy fire axis", "distance_u": 220},
    "projectile_follow": {"engine": "q3mme spline along recognition_projectile_paths keyframes", "source_table": "recognition_projectile_paths", "trail_offset_u": 40, "min_confidence": 0.7, "min_flight_ms": 350},
    "low_angle": {"engine": "freecam below eye line looking up", "height_u": -40}
  },
  "effects": {
    "slow_mo": {"rate": 0.5, "window_ms": 800, "ramp_ms": 100, "engine": "timescale keyframe (capture) or render-side setpts"},
    "freeze": {"duration_ms": 350, "engine": "render-side frame hold"},
    "impact_hold": {"duration_ms": 180, "engine": "render-side"},
    "speed_ramp": {"compress": 1.6, "money_rate": 0.6, "engine": "render-side speed_ramp.py"},
    "zoom_gap": {"zoom": 1.6, "target": "victim_gap", "engine": "render-side crop+scale"},
    "vignette_low_hp": {"opacity": 0.25, "engine": "render-side"},
    "kill_counter": {"engine": "render-side overlay, PANTHEON style"},
    "one_vx_counter": {"engine": "render-side overlay: alive-enemies count"},
    "damage_counter": {"engine": "render-side overlay from lg damage flows"},
    "shake": {"amplitude_px": 6, "engine": "render-side"},
    "speed_lines": {"engine": "render-side, ups-driven"}
  },
  "gates": {
    "min_score_for_effects": 20.0,
    "min_score_for_3d_angle": 30.0,
    "anti_fatigue": "same effect family not twice within 3 consecutive clips",
    "projectile_follow_requires": ["DIRECT_CONFIRMED_GEO|AIR_ROCKET_GEO|AIR_GRENADE", "path_confidence>=0.7"]
  },
  "class_treatments": {
    "DIRECT_CONFIRMED_GEO": {"cameras": ["pov", "projectile_follow"], "effects": ["impact_hold"]},
    "AIR_ROCKET_GEO": {"cameras": ["pov", "projectile_follow"], "effects": ["slow_mo"]},
    "AIR_ROCKET": {"cameras": ["pov"], "effects": ["slow_mo"]},
    "AIR_GRENADE": {"cameras": ["pov", "projectile_follow"], "effects": ["slow_mo"]},
    "NEAR_DIRECT": {"cameras": ["pov"], "effects": []},
    "PREDICTION_TEMPORAL": {"cameras": ["pov", "third_person_reveal"], "effects": ["freeze"]},
    "RAIL_AIR": {"cameras": ["pov"], "effects": ["slow_mo"]},
    "RAIL_CONSECUTIVE": {"cameras": ["pov"], "effects": ["speed_ramp"]},
    "RAIL_FLICK": {"cameras": ["pov"], "effects": ["freeze", "slow_mo"]},
    "PIXEL_SHOT_GEO": {"cameras": ["pov"], "effects": ["freeze", "zoom_gap"]},
    "TINY_GAP_SHOT": {"cameras": ["pov"], "effects": ["freeze", "zoom_gap"]},
    "REACTION_SHOT": {"cameras": ["pov"], "effects": ["speed_ramp"]},
    "CORNER_PREFIRE_CONFIRMED": {"cameras": ["pov", "third_person_reveal"], "effects": []},
    "CLEAN_FLICK": {"cameras": ["pov"], "effects": ["freeze", "slow_mo"]},
    "EXTREME_FLICK": {"cameras": ["pov"], "effects": ["freeze", "slow_mo"]},
    "HIGH_SPEED_AIM_TRANSITION": {"cameras": ["pov"], "effects": ["speed_ramp"]},
    "AGGRESSIVE_TRACKING_SWEEP": {"cameras": ["pov"], "effects": []},
    "TARGET_TRANSFER": {"cameras": ["pov"], "effects": ["speed_ramp"]},
    "LG_HIGH_PRESSURE": {"cameras": ["pov"], "effects": ["shake", "damage_counter"]},
    "LG_HIGH_ACCURACY": {"cameras": ["pov"], "effects": ["damage_counter"]},
    "LG_DODGE_MASTER": {"cameras": ["pov", "dodge_cam"], "effects": ["damage_counter"]},
    "DAMAGE_BURST": {"cameras": ["pov"], "effects": ["speed_ramp", "damage_counter"]},
    "MULTIKILL_DOUBLE": {"cameras": ["pov"], "effects": ["kill_counter"]},
    "MULTIKILL_TRIPLE": {"cameras": ["pov"], "effects": ["kill_counter", "speed_ramp"]},
    "MULTIKILL_QUAD": {"cameras": ["pov", "third_person_orbit"], "effects": ["kill_counter", "slow_mo"]},
    "RAPID_MULTIKILL": {"cameras": ["pov"], "effects": ["speed_ramp", "kill_counter"]},
    "CLUTCH_1V2": {"cameras": ["pov"], "effects": ["one_vx_counter"]},
    "CLUTCH_1V3": {"cameras": ["pov", "third_person_orbit"], "effects": ["one_vx_counter"]},
    "CLUTCH_1V4_PLUS": {"cameras": ["pov", "third_person_orbit"], "effects": ["one_vx_counter", "slow_mo"]},
    "EXTREME_SPEED": {"cameras": ["pov", "third_person_chase"], "effects": ["speed_lines"]},
    "VERY_FAST_FRAG": {"cameras": ["pov"], "effects": ["speed_lines"]},
    "SPEED_TARGET_FRAG": {"cameras": ["pov"], "effects": ["slow_mo"]},
    "HIGH_SPEED_AIR_FRAG": {"cameras": ["pov", "third_person_chase"], "effects": ["slow_mo"]},
    "VERTICAL_ACTION": {"cameras": ["pov", "low_angle"], "effects": []},
    "STRAFE_CHAIN_FRAG": {"cameras": ["pov", "third_person_chase"], "effects": []},
    "ROCKET_JUMP_ENTRY": {"cameras": ["pov", "third_person_chase"], "effects": []},
    "ROCKET_JUMP_FRAG": {"cameras": ["pov", "third_person_chase"], "effects": ["slow_mo"]},
    "DODGE_AND_KILL": {"cameras": ["pov", "dodge_cam"], "effects": []},
    "ESCAPE_TURNAROUND": {"cameras": ["pov", "third_person_reveal"], "effects": []},
    "LOW_HP_FRAG": {"cameras": ["pov"], "effects": ["vignette_low_hp"]},
    "CRITICAL_HP_FRAG": {"cameras": ["pov"], "effects": ["vignette_low_hp"]},
    "LAST_HP_FRAG": {"cameras": ["pov"], "effects": ["vignette_low_hp"]},
    "LOW_HEALTH_WIN": {"cameras": ["pov"], "effects": ["vignette_low_hp"]},
    "WEAPON_COMBO": {"cameras": ["pov"], "effects": ["speed_ramp"]},
    "MULTI_WEAPON_CHAIN": {"cameras": ["pov"], "effects": ["speed_ramp"]},
    "POPUP_COMBO": {"cameras": ["pov"], "effects": ["slow_mo"]}
  },
  "defaults": {"cameras": ["pov"], "effects": []}
}
